# ===== HiveLab 配置模板 =====
# 复制本文件为 .env 并按需修改。切勿把真实的 API Key 提交到仓库。

# LLM 服务商（OpenAI 兼容）
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# 请求参数
LLM_TIMEOUT=120          # 单个请求超时(秒)
LLM_MAX_RETRIES=3        # 最大重试次数
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_STREAM=false         # 是否启用流式输出

# 运行模式
#  auto = 已配置真实模型则用真实模型，否则启用内置 MockLLM（离线可运行）
#  mock = 强制使用内置模拟模型（用于开发和测试）
LLM_PROVIDER=auto
MOCK_PROVIDER=true

# 协作轮询间隔（秒）
GROUP_CHAT_POLL_INTERVAL=60

# 数据存储
# 默认使用位于用户数据目录下的 hivelab.db；可改为绝对路径
DB_PATH=

# 工作目录（生成项目产物的根目录）；留空则使用用户目录下的 HiveLabProjects
WORKSPACE_ROOT=